{
  "name": "cuhalide-atlas-production-qa",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Production browser, accessibility, performance, repository-contract and SEO quality gates for CuHalide Atlas.",
  "scripts": {
    "qa:browser": "playwright test tests/production-browser-v50.spec.js tests/rev7-production-copy.spec.js tests/prepublication-indexing.spec.js",
    "qa:site-quality": "playwright test tests/site-quality-v50-1.spec.js",
    "qa:lighthouse": "bash scripts/production-lighthouse.sh",
    "qa:deployment-gate": "node --test tests/vercel-production-gate.test.mjs",
    "qa:contracts": "node --test tests/rev7-repository-contracts.test.mjs tests/rev7-cleanup-contracts.test.mjs tests/photophysics-private-contract.test.mjs tests/photophysics-source-grain-ui-contract.test.mjs",
    "qa:preflight": "npm run qa:contracts && npm run qa:deployment-gate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "lighthouse": "13.4.1"
  }
}
