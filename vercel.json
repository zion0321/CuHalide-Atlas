{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-production-gate.mjs",
  "functions": {
    "api/site.js": { "includeFiles": "public/index.html" },
    "api/ui-site.js": { "includeFiles": "public/index.html" },
    "api/ui-assistant-current.js": { "includeFiles": "public/index.html" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/ui-assistant-current" },
    { "source": "/index.html", "destination": "/api/ui-assistant-current" },
    { "source": "/api/site", "destination": "/api/ui-site" },
    { "source": "/api/ui-assistant", "destination": "/api/ui-assistant-current" },
    { "source": "/api/record", "destination": "/api/record-current" },
    { "source": "/motifs", "destination": "/api/motifs" },
    { "source": "/article/:id", "destination": "/api/record-current?kind=article&id=:id" },
    { "source": "/structure/:id", "destination": "/api/record-current?kind=structure&id=:id" },
    { "source": "/robots.txt", "destination": "/api/meta?asset=robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/release-manifest.json", "destination": "/api/meta?asset=manifest" },
    { "source": "/citation.txt", "destination": "/api/meta?asset=citation" },
    { "source": "/citation.cff", "destination": "/api/meta?asset=citation" },
    { "source": "/CITATION.cff", "destination": "/api/meta?asset=citation" },
    { "source": "/health.json", "destination": "/api/meta?asset=health" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" },{ "key": "Content-Disposition", "value": "inline; filename=\"index.html\"" },{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },{ "key": "Pragma", "value": "no-cache" },{ "key": "Expires", "value": "0" }] },
    { "source": "/index.html", "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" },{ "key": "Content-Disposition", "value": "inline; filename=\"index.html\"" },{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },{ "key": "Pragma", "value": "no-cache" },{ "key": "Expires", "value": "0" }] },
    { "source": "/motifs", "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] },
    { "source": "/release-manifest.json", "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }] },
    { "source": "/citation.cff", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" },{ "key": "X-Frame-Options", "value": "DENY" },{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },{ "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },{ "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }] }
  ]
}
